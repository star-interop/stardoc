{
    "name": "star-interop/stardoc",
    "type": "library",
    "description": "",
    "keywords": [],
    "license": "MIT",
    "homepage": "https://github.com/star-interop/stardoc",
    "authors": [
        {
            "name": "Paul M. Jones",
            "email": "pmjones@pmjones.io",
            "homepage": "https://pmjones.io",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "autoload": {
        "psr-4" : {
            "StarInterop\\Stardoc\\": "src/"
        }
    },
    "require-dev": {
        "pds/composer-script-names": "^1.0",
        "pds/skeleton": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload-dev": {
        "psr-4" : {
            "StarInterop\\Stardoc\\": "tests/"
        }
    },
    "bin": [
        "./bin/stardoc-readme"
    ],
    "scripts": {
        "analyze": "./vendor/bin/phpstan",
        "check": "composer test && composer analyze && composer cs-check",
        "cs-check": "./vendor/bin/php-styler check",
        "cs-fix": "./vendor/bin/php-styler apply",
        "test": "./vendor/bin/phpunit",
        "test-coverage": "./vendor/bin/phpunit --coverage-html=./tmp/coverage"
    }
}
